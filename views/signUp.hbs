<h2>Upload a File</h2>
<form action="/api/users" method="post" enctype="multipart/form-data">

    <label for="name">Name</label>
    <input type="text" id="name" name="myName">

    <label for="email">EMail</label>
    <input type="email" id="email" name="myEmail">

    <label for="phone">Phone Number</label>
    <input type="number" id="phone" name="myphone">

    <label for="password">Address</label>
    <input type="text" id="password" name="myPassword">

    <button type="submit">Upload</button>
</form>